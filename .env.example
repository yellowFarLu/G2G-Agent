# 复制为 .env 并填入真实值（.env 已被 .gitignore 排除，不会入库）

# 阿里云百炼 API-Key（必填，sk- 开头）：https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=

# 模型（可选，默认如下）
# WIKIAGENT_CHAT_MODEL=qwen-plus
# WIKIAGENT_EMBEDDING_MODEL=text-embedding-v4

# 远程 Milvus 连接（必填；版本需 >= 2.5 以支持 BM25 全文检索）
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_USERNAME=root
MILVUS_PASSWORD=milvus
